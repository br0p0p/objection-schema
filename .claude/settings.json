{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mise install)",
      "Bash(mise exec *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm exec mocha *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec stryker *)",
      "Bash(pnpm exec attw *)",
      "Bash(node scripts/*)",
      "Bash(node bench/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint.js\"",
            "timeout": 60,
            "statusMessage": "Formatting and linting"
          }
        ]
      }
    ]
  }
}
