{
  // zshy (`pnpm run build`) builds lib/ with these options into dist/, twice: CommonJS (.js,
  // .d.ts) and ES modules (.mjs, .d.mts). It sets `module` and `moduleResolution` per build.
  // The tests run against dist/, through the package's `exports`.
  "compilerOptions": {
    // es2022 is what Node 18 (`engines`) runs without downleveling. The lint rules for lib/
    // catch newer built-ins that the `lib` setting alone doesn't.
    "target": "es2022",
    "lib": ["es2022"],
    "rootDir": "lib",
    // For the editor and `tsc` (scripts/mutate-types.js): the CommonJS view, like the `types`.
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "newLine": "lf",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["lib"]
}
