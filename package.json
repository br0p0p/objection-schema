{
  "name": "objection-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-first, class-free models for objection.js 3.x, with Standard Schema validation (zod, valibot, ...) and fully inferred types",
  "author": "Caleb Williams",
  "license": "UNLICENSED",
  "keywords": [
    "objection",
    "orm",
    "knex",
    "typescript",
    "standard-schema",
    "zod",
    "valibot"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.14.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "check": "pnpm run lint && pnpm test",
    "test": "pnpm run test:runtime && pnpm run test:types && pnpm run test:package",
    "test:runtime": "pnpm run build && mocha \"tests/runtime/**/*.test.{js,mjs}\"",
    "test:types": "pnpm run build && tsc -p tests/types/tsconfig.json && tsc -p tests/types/tsconfig.nodenext.json",
    "test:package": "pnpm pack --out node_modules/.cache/package.tgz && attw node_modules/.cache/package.tgz",
    "test:pg": "DB=pg pnpm run test:runtime",
    "test:mysql": "DB=mysql pnpm run test:runtime",
    "test:pack": "node scripts/test-pack.js",
    "test:properties": "pnpm run build && mocha --timeout 60000 tests/runtime/properties.test.js",
    "test:objection-versions": "node scripts/test-objection-versions.js",
    "test:mutations": "stryker run",
    "test:mutations:types": "node scripts/mutate-types.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:anti-slop": "oxlint --max-warnings 0 .",
    "bench": "pnpm run build && node bench/compare.js",
    "bench:validation": "pnpm run build && node bench/zod-cost.js",
    "bench:typecheck": "pnpm run build && node bench/tooling/typecheck-scale.js",
    "bench:completions": "pnpm run build && node bench/tooling/completions.js"
  },
  "peerDependencies": {
    "objection": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@arethetypeswrong/cli": "^0.18.5",
    "@oxlint/plugins": "1.89.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/mocha-runner": "^10.0.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "expect.js": "^0.3.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "knex": "^3.3.0",
    "mocha": "^11.8.0",
    "mysql2": "^3.24.6",
    "objection": "^3.9.1",
    "oxlint": "1.89.0",
    "pg": "^8.23.1",
    "sqlite3": "^5.1.7",
    "typescript": "~5.8",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  }
}
